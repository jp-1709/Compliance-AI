  },
  {
   "fieldname": "voided_by",
   "label": "Voided By",
   "fieldtype": "Link",
   "options": "User",
   "depends_on": "eval:doc.is_voided == 1"
  },
  {
   "fieldname": "voided_on",
   "label": "Voided On",
   "fieldtype": "Datetime",
   "depends_on": "eval:doc.is_voided == 1"
