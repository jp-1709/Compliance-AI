  },
  {
   "fieldname": "description",
   "label": "Description",
   "fieldtype": "Long Text",
   "reqd": 1
  },
  {
   "fieldname": "rationale",
   "label": "Rationale",
   "fieldtype": "Long Text",
   "reqd": 1
