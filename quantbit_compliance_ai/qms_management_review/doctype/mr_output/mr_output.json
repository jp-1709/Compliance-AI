   "fieldtype": "Check"
  },
  {
   "fieldname": "is_strategic_direction_integration",
   "label": "Is Strategic Direction Integration",
   "fieldtype": "Check"
  },
  {
   "fieldname": "is_resource_need",
   "label": "Is Resource Need",
   "fieldtype": "Check"
  },
  {
   "fieldname": "is_change_to_qms",
   "label": "Is Change To Qms",
   "fieldtype": "Check"
  },
  {
