{
 "doctype": "DocType",
 "name": "MR Output",
 "module": "QMS Management Review",
 "autoname": "MRO-.YYYY.-.######",
 "track_changes": 1,
 "is_submittable": 1,
 "title_field": "title",
 "fields": [
  {
   "fieldname": "tab_overview",
   "label": "Overview",
   "fieldtype": "Tab Break"
  },
  {
   "fieldname": "section_overview",
   "label": "Output identity and classification",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "cycle",
   "label": "Cycle",
   "fieldtype": "Link",
   "options": "MR Cycle",
   "reqd": 1
  },
  {
   "fieldname": "meeting",
   "label": "Meeting",
   "fieldtype": "Link",
   "options": "MR Meeting",
   "reqd": 1
  },
  {
   "fieldname": "entity",
   "label": "Entity",
   "fieldtype": "Link",
   "options": "Business Entity",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "output_type",
   "label": "Output Type",
   "fieldtype": "Select",
   "options": "Open CAPA\nDocument Change\nOpen Audit\nRisk Treatment\nTraining Initiative\nResource Allocation\nPolicy Change\nObjective Revision\nStrategic Direction\nCommunication Action\nStakeholder Engagement\nContinual Improvement Project\nSuspend / Withdraw / Recall Action\nAcknowledgement (no further action)\nCarry Forward to Next Cycle\nOther",
   "reqd": 1
  },
  {
   "fieldname": "severity_classification",
