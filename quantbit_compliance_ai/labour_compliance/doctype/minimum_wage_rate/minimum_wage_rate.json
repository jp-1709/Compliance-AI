   "in_standard_filter": 1
  },
  {
   "fieldname": "skill_category",
   "label": "Skill Category",
   "fieldtype": "Select",
   "options": "Unskilled\nSemi-Skilled\nSkilled\nHighly Skilled",
   "default": "Unskilled",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "cb_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "monthly_rate_inr",
   "label": "Monthly Rate (₹)",
   "fieldtype": "Currency",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sec_validity",
   "label": "Validity",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "effective_from",
   "label": "Effective From",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "cb_2",
   "fieldtype": "Column Break"
  },
  {
