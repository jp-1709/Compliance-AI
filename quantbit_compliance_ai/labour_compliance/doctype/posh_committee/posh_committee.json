{
    "doctype": "DocType",
    "name": "POSH Committee",
    "module": "Labour Compliance",
    "naming_rule": "By \"Naming Series\"",
    "autoname": "POSH-IC-.YYYY.-.######",
    "track_changes": 1,
    "title_field": "business_entity",
    "search_fields": "business_entity,organisation",
    "description": "Internal Committee constituted under Prevention of Sexual Harassment (POSH) Act 2013. Mandatory at 10+ TOTAL employees (any gender — commonly misread as '10+ women'). Statutory max tenure 3 years. IC must: have a woman Presiding Officer, ≥50% women members, at least 1 external NGO/expert member.",
    "fields": [
        {
            "fieldname": "tab_constitution",
            "label": "Constitution",
            "fieldtype": "Tab Break"
        },
        {
            "fieldname": "sec_identity",
            "label": "Committee Identity",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "organisation",
            "label": "Organisation",
            "fieldtype": "Link",
            "options": "Organisation",
            "reqd": 1,
            "in_standard_filter": 1,
            "read_only_onsave": 1
        },
        {
            "fieldname": "business_entity",
            "label": "Business Entity",
            "fieldtype": "Link",
            "options": "Business Entity",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1,
            "read_only_onsave": 1
        },
        {
            "fieldname": "committee_status",
            "label": "Status",
            "fieldtype": "Select",
            "options": "Constituted\nUnder Reconstitution\nDissolved",
            "default": "Constituted",
            "in_list_view": 1
        },
        {
            "fieldname": "cb_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "constituted_on",
            "label": "Constituted On",
            "fieldtype": "Date",
            "reqd": 1
        },
        {
            "fieldname": "tenure_years",
            "label": "Tenure (Years)",
            "fieldtype": "Int",
            "default": 3,
            "description": "Statutory maximum tenure is 3 years (POSH Act §4(3)). Auto-renewal task created 60 days before tenure_end."
        },
        {
            "fieldname": "tenure_end",
            "label": "Tenure End Date",
            "fieldtype": "Date",
            "read_only": 1,
            "in_list_view": 1,
            "description": "Auto-computed: constituted_on + tenure_years. Renewal task auto-created 60 days before this date."
        },
        {
            "fieldname": "constitution_order_evidence",
            "label": "Constitution Order",
            "fieldtype": "Link",
            "options": "Evidence File",
            "reqd": 1,
            "description": "Signed office order constituting the IC. Required for POSH audit compliance."
        },
        {
            "fieldname": "tab_members",
            "label": "Members",
            "fieldtype": "Tab Break"
        },
        {
            "fieldname": "sec_members",
            "label": "Committee Members",
            "fieldtype": "Section Break",
            "description": "Minimum 4 members: 1 Presiding Officer (woman, senior employee), 2 internal members (preferably women, committed to women's causes), 1 external NGO/expert. POSH Act §4(2)."
        },
        {
            "fieldname": "members",
            "label": "Committee Members",
            "fieldtype": "Table",
            "options": "POSH Committee Member",
            "reqd": 1
        },
        {
            "fieldname": "tab_compliance",
            "label": "Compliance Status",
            "fieldtype": "Tab Break"
        },
        {
            "fieldname": "sec_compliance",
            "label": "Statutory Compliance Indicators",
            "fieldtype": "Section Break",
            "description": "All indicators auto-computed on save from the members table."
        },
        {
            "fieldname": "presiding_officer_is_woman",
            "label": "Presiding Officer is Woman",
            "fieldtype": "Check",
            "default": 0,
            "read_only": 1,
            "description": "Mandatory under POSH Act §4(2)(a)."
        },
        {
            "fieldname": "has_external_member",
            "label": "Has External Member (NGO/Expert)",
            "fieldtype": "Check",
            "default": 0,
            "read_only": 1,
            "description": "Mandatory under POSH Act §4(2)(d). Must be from an NGO or someone familiar with issues related to sexual harassment."
        },
        {
            "fieldname": "min_50pct_women_members",
            "label": "≥50% Women Members",
            "fieldtype": "Check",
            "default": 0,
            "read_only": 1,
            "description": "Mandatory under POSH Act §4(2). Includes Presiding Officer."
        },
        {
            "fieldname": "cb_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "ic_compliant",
            "label": "IC Statutorily Compliant",
            "fieldtype": "Check",
            "default": 0,
            "read_only": 1,
            "in_list_view": 1,
            "bold": 1,
            "description": "All three structure requirements met: woman PO + ≥50% women + external member."
        },
        {
            "fieldname": "non_compliance_reasons",
            "label": "Non-Compliance Reasons",
            "fieldtype": "Small Text",
            "read_only": 1,
            "description": "Lists all specific gaps. Must be empty for ic_compliant = 1."
        },
        {
            "fieldname": "tab_training",
            "label": "Training & Reports",
            "fieldtype": "Tab Break"
        },
        {
            "fieldname": "sec_training",
            "label": "Training & Awareness",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "last_training_for_members",
            "label": "Last IC Member Training",
            "fieldtype": "Date"
        },
        {
            "fieldname": "next_training_due",
            "label": "Next Member Training Due",
            "fieldtype": "Date",
            "read_only": 1,
            "description": "Auto-computed: last_training_for_members + 1 year."
        },
        {
            "fieldname": "last_employee_awareness_session",
            "label": "Last All-Employee Awareness Session",
            "fieldtype": "Date"
        },
        {
            "fieldname": "awareness_sessions_this_year",
            "label": "Awareness Sessions This Year",
            "fieldtype": "Int",
            "default": 0
        },
        {
            "fieldname": "cb_3",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "annual_report_last_filed",
            "label": "Annual Report Last Filed (to District Officer)",
            "fieldtype": "Date",
            "description": "Mandatory by 31 January every calendar year (not FY). Report filed to District Magistrate / local authority. Note: calendar year, not financial year — many miss this."
        },
        {
            "fieldname": "annual_report_evidence",
            "label": "Last Annual Report",
            "fieldtype": "Link",
            "options": "Evidence File"
        },
        {
            "fieldname": "complaints_received_ytd",
            "label": "Complaints Received YTD",
            "fieldtype": "Int",
            "default": 0,
            "read_only": 1,
            "description": "Auto-rolled up from POSH Complaint records."
        },
        {
            "fieldname": "complaints_disposed_ytd",
            "label": "Complaints Disposed YTD",
            "fieldtype": "Int",
            "default": 0,
            "read_only": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Compliance Officer",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Department Manager",
            "read": 1,
            "report": 1
        },
        {
            "role": "Internal Auditor",
            "read": 1,
            "report": 1
        },
        {
            "role": "POSH IC Member",
            "read": 1,
            "write": 1,
            "report": 1
        },
        {
            "role": "Read Only",
            "read": 1
        }
    ]
}