        {
            "fieldname": "max_entities",
            "label": "Max Entities",
            "fieldtype": "Int",
            "default": 1
        },
        {
            "fieldname": "cb_4",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "is_active",
            "label": "Active",
            "fieldtype": "Check",
            "default": 1
        },
        {
            "fieldname": "primary_contact",
            "label": "Primary Contact",
            "fieldtype": "Link",
            "options": "User"
        },
        {
            "fieldname": "logo",
            "label": "Logo",
            "fieldtype": "Attach Image"
        },
        {
            "fieldname": "sec_modules",
            "label": "Module Access",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "modules_enabled",
            "label": "Enabled Modules",
            "fieldtype": "Table MultiSelect",
            "options": "Organisation Module Access",
            "description": "Which modules are enabled for this org based on their plan"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 0,
            "report": 1,
            "export": 1
        },
        {
            "role": "Group CXO",
            "read": 1,
            "write": 1,
            "report": 1,
            "export": 1,
            "if_owner": 0
        }
    ]
