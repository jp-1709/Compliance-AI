            "reqd": 1,
            "description": "6-digit Indian PIN code"
        },
        {
            "fieldname": "country",
            "label": "Country",
            "fieldtype": "Link",
            "options": "Country",
            "default": "India",
            "reqd": 1
        },
        {
            "fieldname": "phone",
            "label": "Phone",
            "fieldtype": "Data",
            "description": "Format: +91XXXXXXXXXX"
        },
        {
            "fieldname": "email",
            "label": "Email",
            "fieldtype": "Data",
            "options": "Email"
        },
        {
            "fieldname": "website",
            "label": "Website",
            "fieldtype": "Data"
        },
        {
            "fieldname": "sec_subscription",
            "label": "Subscription",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "subscription_plan",
            "label": "Plan",
            "fieldtype": "Select",
            "options": "Trial\nStarter\nBusiness\nEnterprise",
            "default": "Trial"
