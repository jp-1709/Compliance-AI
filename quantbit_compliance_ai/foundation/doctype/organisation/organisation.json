{
    "doctype": "DocType",
    "name": "Organisation",
    "module": "Foundation",
    "naming_rule": "By field: organisation_code",
    "autoname": "field:organisation_code",
    "is_submittable": 0,
    "track_changes": 1,
    "track_seen": 1,
    "description": "Top-level SaaS tenant. One Organisation = one customer subscription.",
    "fields": [
        {
            "fieldname": "organisation_code",
            "label": "Organisation Code",
            "fieldtype": "Data",
            "reqd": 1,
            "unique": 1,
            "in_list_view": 1,
            "bold": 1,
            "description": "Short unique code, e.g. ACME, TATA. Used as document name."
        },
        {
            "fieldname": "organisation_name",
            "label": "Organisation Name",
            "fieldtype": "Data",
            "reqd": 1,
            "in_list_view": 1,
            "in_global_search": 1
        },
        {
            "fieldname": "legal_name",
            "label": "Legal Name (as per CIN/PAN)",
            "fieldtype": "Data",
            "reqd": 1
        },
        {
            "fieldname": "cb_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "industry_sector",
            "label": "Industry Sector",
            "fieldtype": "Link",
            "options": "Industry Sector",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "business_type",
            "label": "Business Type",
            "fieldtype": "Select",
            "options": "Private Limited\nPublic Limited\nLLP\nPartnership\nProprietorship\nGovernment\nNon-Profit\nOther",
            "reqd": 1
        },
        {
            "fieldname": "is_listed",
            "label": "Listed Entity",
            "fieldtype": "Check",
            "default": 0,
            "description": "If listed, SEBI LODR obligations apply"
        },
        {
            "fieldname": "sec_identifiers",
            "label": "Identifiers",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "cin",
            "label": "CIN",
            "fieldtype": "Data",
            "description": "Corporate Identification Number (MCA). Format: L12345AB2020ABC123456"
        },
        {
            "fieldname": "pan",
            "label": "PAN",
            "fieldtype": "Data",
            "reqd": 1,
            "description": "Permanent Account Number. Format: AAAAA9999A"
        },
        {
            "fieldname": "tan",
            "label": "TAN",
            "fieldtype": "Data"
        },
        {
            "fieldname": "cb_2",
            "fieldtype": "Column Break"
        },
