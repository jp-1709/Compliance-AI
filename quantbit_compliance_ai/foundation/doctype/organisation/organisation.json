        },
        {
            "fieldname": "lei",
            "label": "LEI",
            "fieldtype": "Data",
            "description": "Legal Entity Identifier (20-char alphanumeric)"
        },
        {
            "fieldname": "incorporation_date",
            "label": "Incorporation Date",
            "fieldtype": "Date"
        },
        {
            "fieldname": "sec_address",
            "label": "Registered Address",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "address_line_1",
            "label": "Address Line 1",
            "fieldtype": "Data",
            "reqd": 1
        },
        {
            "fieldname": "address_line_2",
            "label": "Address Line 2",
            "fieldtype": "Data"
        },
        {
            "fieldname": "city",
            "label": "City",
            "fieldtype": "Data",
            "reqd": 1
        },
        {
            "fieldname": "state",
            "label": "State",
            "fieldtype": "Link",
            "options": "State",
            "reqd": 1
        },
        {
            "fieldname": "cb_3",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "pincode",
            "label": "PIN Code",
