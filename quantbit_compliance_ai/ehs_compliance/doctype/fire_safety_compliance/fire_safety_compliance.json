{
    "doctype": "DocType",
    "name": "Fire Safety Compliance",
    "module": "EHS Compliance",
    "naming_rule": "By field: business_entity",
    "autoname": "field:business_entity",
    "is_submittable": 0,
    "track_changes": 1,
