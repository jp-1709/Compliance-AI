{
    "doctype": "DocType",
    "name": "Clearance Specific Condition",
    "module": "EHS Compliance",
    "istable": 1,
    "description": "Child table for Environmental Clearance — tracks each specific condition and its compliance status.",
    "fields": [
        {
            "fieldname": "condition_no",
            "label": "Condition No.",
            "fieldtype": "Data",
            "in_list_view": 1,
            "reqd": 1,
            "columns": 1
        },
        {
            "fieldname": "condition_text",
            "label": "Condition Text",
            "fieldtype": "Small Text",
            "reqd": 1,
            "in_list_view": 1,
            "columns": 4
        },
        {
            "fieldname": "compliance_status",
            "label": "Compliance Status",
            "fieldtype": "Select",
            "options": "Compliant\nPartially Compliant\nNon-Compliant\nNot Applicable Yet\nUnder Verification",
            "default": "Compliant",
            "in_list_view": 1,
            "columns": 2
        },
        {
            "fieldname": "cb_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "evidence",
            "label": "Compliance Evidence",
            "fieldtype": "Link",
            "options": "Evidence File"
        },
        {
            "fieldname": "next_review_date",
            "label": "Next Review Date",
            "fieldtype": "Date"
        },
        {
            "fieldname": "remarks",
            "label": "Remarks",
            "fieldtype": "Small Text"
        }
    ]
}