{
    "doctype": "DocType",
    "name": "Shareholder Meeting",
    "module": "Secretarial Compliance",
    "naming_rule": "By \"Naming Series\"",
    "autoname": "SHM-.YYYY.-.######",
    "is_submittable": 1,
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "tab_overview",
            "label": "Overview",
            "fieldtype": "Tab Break"
        },
        {
            "fieldname": "sec_identity",
            "label": "Meeting Identity",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "organisation",
            "label": "Organisation",
            "fieldtype": "Link",
            "options": "Organisation",
            "reqd": 1,
            "in_standard_filter": 1,
            "read_only_onsave": 1
        },
        {
            "fieldname": "business_entity",
            "label": "Business Entity",
            "fieldtype": "Link",
            "options": "Business Entity",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1,
            "read_only_onsave": 1
        },
        {
            "fieldname": "meeting_type",
            "label": "Meeting Type",
            "fieldtype": "Select",
            "options": "AGM\nEGM\nClass Meeting\nCourt-Convened\nPostal Ballot\nE-Voting Only",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "meeting_status",
            "label": "Status",
            "fieldtype": "Select",
            "options": "Planned\nNotice Issued\nHeld\nAdjourned\nCancelled",
            "default": "Planned",
            "in_list_view": 1
        },
        {
            "fieldname": "cb_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "fy",
            "label": "FY",
            "fieldtype": "Data",
            "reqd": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "meeting_date",
            "label": "Meeting Date",
            "fieldtype": "Date",
            "reqd": 1,
            "in_list_view": 1,
            "description": "AGM: within 6 months of FY end (§96)"
        },
        {
            "fieldname": "is_first_agm",
            "label": "First AGM",
            "fieldtype": "Check",
            "default": 0,
            "description": "First AGM allowed within 9 months of FY end"
        },
        {
            "fieldname": "agm_extended",
            "label": "AGM Extended (RoC Approval)",
            "fieldtype": "Check",
            "default": 0
        },
        {
            "fieldname": "extension_evidence",
            "label": "Extension Approval",
            "fieldtype": "Link",
            "options": "Evidence File",
            "depends_on": "agm_extended"
        },
        {
            "fieldname": "tab_venue_notice",
            "label": "Venue & Notice",
            "fieldtype": "Tab Break"
        },
        {
            "fieldname": "sec_venue",
            "label": "Venue",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "venue_type",
            "label": "Mode",
            "fieldtype": "Select",
            "options": "Physical\nVideo Conference (VC)\nHybrid",
            "default": "Hybrid"
        },
        {
            "fieldname": "venue_address",
            "label": "Venue Address",
            "fieldtype": "Small Text"
        },
        {
            "fieldname": "sec_notice",
            "label": "Notice",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "notice_dispatched_on",
            "label": "Notice Dispatched",
            "fieldtype": "Date",
            "description": "≥21 clear days before meeting (§101)"
        },
        {
            "fieldname": "shorter_notice_consent",
            "label": "Shorter Notice Consent",
            "fieldtype": "Check",
            "default": 0
        },
        {
            "fieldname": "notice_evidence",
            "label": "Notice Copy",
            "fieldtype": "Link",
            "options": "Evidence File"
        },
        {
            "fieldname": "explanatory_statement_evidence",
            "label": "Explanatory Statement",
            "fieldtype": "Link",
            "options": "Evidence File"
        },
        {
            "fieldname": "cb_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "newspaper_publication_evidence",
            "label": "Newspaper Publication",
            "fieldtype": "Link",
            "options": "Evidence File",
            "description": "If listed entity / required"
        },
        {
            "fieldname": "tab_attendance",
            "label": "Attendance & Quorum",
            "fieldtype": "Tab Break"
        },
        {
            "fieldname": "sec_attendance",
            "label": "Attendance & Quorum",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "shareholders_invited_count",
            "label": "Members on Register",
            "fieldtype": "Int"
        },
        {
            "fieldname": "shareholders_present_count",
            "label": "Members Present",
            "fieldtype": "Int"
        },
        {
            "fieldname": "quorum_met",
            "label": "Quorum Met",
            "fieldtype": "Check",
            "read_only": 1,
            "description": "Per §103: 5/15/30 depending on member count"
        },
        {
            "fieldname": "voting_through_e_voting",
            "label": "E-Voting Used",
            "fieldtype": "Check",
            "default": 0,
            "description": "Mandatory for ≥1000 members or listed (§108)"
        },
        {
            "fieldname": "scrutinizer_appointed",
            "label": "Scrutinizer Appointed",
            "fieldtype": "Check",
            "default": 0
        },
        {
            "fieldname": "cb_3",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "scrutinizer_report_evidence",
            "label": "Scrutinizer Report",
            "fieldtype": "Link",
            "options": "Evidence File"
        },
        {
            "fieldname": "tab_outcomes",
            "label": "Outcomes",
            "fieldtype": "Tab Break"
        },
        {
            "fieldname": "sec_outcomes",
            "label": "Outcomes",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "resolutions_passed_count",
            "label": "Resolutions Passed",
            "fieldtype": "Int",
            "default": 0,
            "read_only": 1
        },
        {
            "fieldname": "minutes_evidence",
            "label": "Signed Minutes",
            "fieldtype": "Link",
            "options": "Evidence File"
        },
        {
            "fieldname": "linked_compliance_task",
            "label": "Linked Compliance Task",
            "fieldtype": "Link",
            "options": "Compliance Calendar Task"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Compliance Officer",
            "read": 1,
            "write": 1,
            "create": 1,
            "submit": 1,
            "cancel": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Legal Counsel",
            "read": 1,
            "write": 1,
            "report": 1
        },
        {
            "role": "Group CXO",
            "read": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Internal Auditor",
            "read": 1,
            "report": 1
        }
    ]
}