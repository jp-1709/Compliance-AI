        {
            "fieldname": "entity_type",
            "label": "Entity Type",
            "fieldtype": "Select",
            "options": "Head Office\nFactory/Plant\nBranch\nWarehouse\nR&D Centre\nSales Office\nSubsidiary\nOther"
        },
        {
            "fieldname": "sec_results",
            "label": "Last Run Results",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "last_run_at",
            "label": "Last Run",
            "fieldtype": "Datetime",
            "read_only": 1
        },
        {
            "fieldname": "last_run_passed",
            "label": "Last Run Passed",
            "fieldtype": "Check",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "last_run_actual",
            "label": "Last Run — Actual Result",
            "fieldtype": "Check",
            "read_only": 1
        },
        {
            "fieldname": "last_run_trace",
            "label": "Last Run — Rule Trace",
