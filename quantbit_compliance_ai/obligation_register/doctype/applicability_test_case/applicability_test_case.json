        },
        {
            "fieldname": "industry_code",
            "label": "Industry Code",
            "fieldtype": "Link",
            "options": "Industry Code"
        },
        {
            "fieldname": "state",
            "label": "State",
            "fieldtype": "Link",
            "options": "State"
        },
        {
            "fieldname": "employee_count",
            "label": "Employee Count",
            "fieldtype": "Int"
        },
        {
            "fieldname": "turnover_inr_cr",
            "label": "Turnover (₹ Cr)",
            "fieldtype": "Float"
        },
        {
            "fieldname": "cb_profile",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "is_listed",
            "label": "Listed",
            "fieldtype": "Check",
            "default": 0
        },
        {
            "fieldname": "is_hazardous",
            "label": "Hazardous",
            "fieldtype": "Check",
            "default": 0
        },
        {
            "fieldname": "is_msme",
            "label": "MSME",
            "fieldtype": "Check",
            "default": 0
