{
    "doctype": "DocType",
    "name": "TCS Return",
    "module": "Tax GST Compliance",
    "naming_rule": "By \"Naming Series\"",
    "autoname": "TCS-.YYYY.-.######",
    "is_submittable": 1,
    "track_changes": 1,
    "description": "Form 27EQ \u2014 TCS quarterly return. Structurally similar to TDS Return.",
    "fields": [
        {
            "fieldname": "organisation",
            "label": "Organisation",
            "fieldtype": "Link",
            "options": "Organisation",
            "reqd": 1,
            "in_standard_filter": 1,
            "read_only_onsave": 1,
            "bold": 1
        },
        {
            "fieldname": "business_entity",
            "label": "Business Entity",
            "fieldtype": "Link",
            "options": "Business Entity",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1,
            "read_only_onsave": 1,
            "bold": 1
        },
        {
            "fieldname": "tax_registration",
            "label": "TAN",
            "fieldtype": "Link",
            "options": "Tax Registration",
            "reqd": 1
        },
        {
            "fieldname": "filing_status",
            "label": "Status",
            "fieldtype": "Select",
            "options": "Pending\nIn Preparation\nFiled\nFiled with Late Fee\nDefective\nCorrected",
            "default": "Pending",
            "in_list_view": 1
        },
        {
            "fieldname": "cb_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "period_quarter",
            "label": "Quarter",
            "fieldtype": "Select",
            "options": "Q1 (Apr-Jun)\nQ2 (Jul-Sep)\nQ3 (Oct-Dec)\nQ4 (Jan-Mar)",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "period_fy",
            "label": "FY",
            "fieldtype": "Data",
            "reqd": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "filing_due_date",
            "label": "Filing Due Date",
            "fieldtype": "Date",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "filed_on",
            "label": "Filed On",
            "fieldtype": "Date"
        },
        {
            "fieldname": "delay_days",
            "label": "Delay (Days)",
            "fieldtype": "Int",
            "default": "0",
            "read_only": 1
        },
        {
            "fieldname": "sec_summary",
            "label": "Summary",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "total_collectees",
            "label": "Total Collectees",
            "fieldtype": "Int",
            "default": "0"
        },
        {
            "fieldname": "total_amount_collected_inr",
            "label": "Total Amount Collected (\u20b9)",
            "fieldtype": "Currency"
        },
        {
            "fieldname": "total_tcs_collected_inr",
            "label": "Total TCS Collected (\u20b9)",
            "fieldtype": "Currency",
            "in_list_view": 1
        },
        {
            "fieldname": "total_tcs_deposited_inr",
            "label": "Total TCS Deposited (\u20b9)",
            "fieldtype": "Currency"
        },
        {
            "fieldname": "cb_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "late_fee_inr",
            "label": "Late Fee (\u20b9)",
            "fieldtype": "Currency",
            "default": "0",
            "read_only": 1
        },
        {
            "fieldname": "filed_return_evidence",
            "label": "FVU File / Acknowledgement",
            "fieldtype": "Link",
            "options": "Evidence File"
        },
        {
            "fieldname": "form_27d_issued_count",
            "label": "Form 27D Issued",
            "fieldtype": "Int",
            "default": "0"
        },
        {
            "fieldname": "linked_compliance_task",
            "label": "Linked Compliance Task",
            "fieldtype": "Link",
            "options": "Compliance Calendar Task",
            "read_only": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1,
            "amend": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Compliance Officer",
            "read": 1,
            "write": 1,
            "create": 1,
            "submit": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Tax Head",
            "read": 1,
            "write": 1,
            "create": 1,
            "submit": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Accounts Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1
        },
        {
            "role": "Internal Auditor",
            "read": 1,
            "report": 1
        },
        {
            "role": "CFO",
            "read": 1,
            "report": 1,
            "export": 1
        }
    ],
    "indexes": [
        {
            "fields": [
                "organisation",
                "tax_registration",
                "period_quarter",
                "period_fy"
            ],
            "unique": 1
        }
    ],
    "sort_field": "filing_due_date",
    "sort_order": "ASC"
}