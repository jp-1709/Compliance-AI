{
    "doctype": "DocType",
    "name": "E-Way Bill Record",
    "module": "Tax GST Compliance",
    "naming_rule": "By \"Naming Series\"",
    "autoname": "EWB-.YYYY.-.######",
    "track_changes": 1,
    "description": "Per-shipment EWB record. Required for goods movement \u2265 \u20b950,000.",
    "fields": [
        {
            "fieldname": "organisation",
            "label": "Organisation",
            "fieldtype": "Link",
            "options": "Organisation",
            "reqd": 1,
            "in_standard_filter": 1,
            "read_only_onsave": 1,
            "bold": 1
        },
        {
            "fieldname": "business_entity",
            "label": "Business Entity",
            "fieldtype": "Link",
            "options": "Business Entity",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1,
            "read_only_onsave": 1,
            "bold": 1
        },
        {
            "fieldname": "ewb_number",
            "label": "E-Way Bill Number",
            "fieldtype": "Data",
            "in_list_view": 1,
            "description": "12-digit, generated by GST portal"
        },
        {
            "fieldname": "ewb_status",
            "label": "Status",
            "fieldtype": "Select",
            "options": "Draft\nGenerated\nIn Transit\nDelivered\nCancelled\nExpired",
            "default": "Draft",
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "cb_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "tax_registration",
            "label": "Supplier GSTIN",
            "fieldtype": "Link",
            "options": "Tax Registration",
            "reqd": 1
        },
        {
            "fieldname": "movement_type",
            "label": "Movement Type",
            "fieldtype": "Select",
            "options": "Outward Supply\nInward Supply\nJob Work\nSKD/CKD\nLine Sales\nSales Return\nExport\nImport\nFor Own Use\nExhibition / Fair",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "linked_einvoice",
            "label": "Linked E-Invoice",
            "fieldtype": "Link",
            "options": "E-Invoice Record"
        },
        {
            "fieldname": "linked_invoice_number",
            "label": "Invoice Number",
            "fieldtype": "Data",
            "in_list_view": 1
        },
        {
            "fieldname": "linked_invoice_date",
            "label": "Invoice Date",
            "fieldtype": "Date"
        },
        {
            "fieldname": "sec_movement",
            "label": "Movement Details",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "from_pincode",
            "label": "From PIN",
            "fieldtype": "Data",
            "reqd": 1
        },
        {
            "fieldname": "from_state",
            "label": "From State",
            "fieldtype": "Link",
            "options": "State",
            "reqd": 1
        },
        {
            "fieldname": "to_pincode",
            "label": "To PIN",
            "fieldtype": "Data",
            "reqd": 1
        },
        {
            "fieldname": "to_state",
            "label": "To State",
            "fieldtype": "Link",
            "options": "State",
            "reqd": 1
        },
        {
            "fieldname": "cb_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "approx_distance_km",
            "label": "Approx. Distance (km)",
            "fieldtype": "Int",
            "reqd": 1
        },
        {
            "fieldname": "transport_mode",
            "label": "Transport Mode",
            "fieldtype": "Select",
            "options": "Road\nRail\nAir\nShip",
            "reqd": 1,
            "default": "Road"
        },
        {
            "fieldname": "vehicle_number",
            "label": "Vehicle Number",
            "fieldtype": "Data",
            "depends_on": "eval:doc.transport_mode=='Road'"
        },
        {
            "fieldname": "transporter_id",
            "label": "Transporter ID (GSTIN/TRANSIN)",
            "fieldtype": "Data"
        },
        {
            "fieldname": "transporter_doc_number",
            "label": "Transport Doc No (LR/RR/AWB)",
            "fieldtype": "Data"
        },
        {
            "fieldname": "sec_validity",
            "label": "Validity",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "generated_at",
            "label": "Generated At",
            "fieldtype": "Datetime"
        },
        {
            "fieldname": "valid_until",
            "label": "Valid Until",
            "fieldtype": "Datetime",
            "in_list_view": 1,
            "description": "1 day per 200 km (Over Dimensional Cargo: 1 day per 20 km)"
        },
        {
            "fieldname": "is_extended",
            "label": "Validity Extended",
            "fieldtype": "Check",
            "default": "0"
        },
        {
            "fieldname": "extension_reason",
            "label": "Extension Reason",
            "fieldtype": "Small Text",
            "depends_on": "is_extended"
        },
        {
            "fieldname": "cb_3",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "is_expired",
            "label": "Expired",
            "fieldtype": "Check",
            "default": "0",
            "read_only": 1,
            "description": "Goods cannot move after expiry \u2014 penalty risk"
        },
        {
            "fieldname": "sec_amounts",
            "label": "Amounts",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "taxable_value_inr",
            "label": "Taxable Value (\u20b9)",
            "fieldtype": "Currency",
            "reqd": 1
        },
        {
            "fieldname": "tax_amount_inr",
            "label": "Tax Amount (\u20b9)",
            "fieldtype": "Currency",
            "reqd": 1
        },
        {
            "fieldname": "total_value_inr",
            "label": "Total Value (\u20b9)",
            "fieldtype": "Currency",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "cb_4",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "cancellation_date",
            "label": "Cancellation Date",
            "fieldtype": "Datetime",
            "description": "Within 24 hours only"
        },
        {
            "fieldname": "cancellation_reason",
            "label": "Cancellation Reason",
            "fieldtype": "Small Text"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Compliance Officer",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Tax Head",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1,
            "export": 1
        },
        {
            "role": "Accounts Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "report": 1
        },
        {
            "role": "Internal Auditor",
            "read": 1,
            "report": 1
        }
    ],
    "indexes": [
        {
            "fields": [
                "ewb_number"
            ],
            "unique": 1
        },
        {
            "fields": [
                "organisation",
                "ewb_status",
                "valid_until"
            ]
        }
    ],
    "sort_field": "generated_at",
    "sort_order": "DESC"
}